export function getProductById(id) {
  return PRODUCTS.find((product) => product.id === id) || PRODUCTS[0];
}

export function formatCurrency(amount) {
  return `$${Number(amount).toFixed(2)}`;
}
import { getProductById, formatCurrency } from './products.js';

const CART_STORAGE_KEY = 'bk_official_cart_v1';

export function getCart() {
  try {
    const raw = localStorage.getItem(CART_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch (error) {
    console.error('Unable to read cart from localStorage:', error);
    return [];
  }
}

function saveCart(items) {
  try {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(items));
  } catch (error) {
    console.error('Unable to save cart to localStorage:', error);
  }
  updateCartBadge();
}

export function updateCartBadge() {
  const badge = document.getElementById('cart-count');
  if (!badge) return;
  const totalCount = getCart().reduce((sum, item) => sum + item.quantity, 0);
  badge.textContent = String(totalCount);
}

export function addToCart(productId, size = 'M', color = '', quantity = 1) {
  const product = getProductById(productId);
  if (!product) return;

  const selectedColor = color || product.colors[0]?.name || 'Standard';
  const safeQty = Math.max(1, Math.min(20, Number(quantity) || 1));
  const cart = getCart();

  const existingIndex = cart.findIndex(
    (item) => item.productId === product.id && item.size === size && item.color === selectedColor
  );

  if (existingIndex > -1) {
    cart[existingIndex].quantity = Math.min(20, cart[existingIndex].quantity + safeQty);
  } else {
    cart.push({
      productId: product.id,
      size,
      color: selectedColor,
      quantity: safeQty
    });
  }

  saveCart(cart);
}

export function updateCartItemQuantity(index, delta) {
  const cart = getCart();
  if (!cart[index]) return;

  const nextQty = cart[index].quantity + delta;
  if (nextQty <= 0) {
    cart.splice(index, 1);
  } else {
    cart[index].quantity = Math.min(20, nextQty);
  }
  saveCart(cart);
}

export function removeCartItem(index) {
  const cart = getCart();
  if (!cart[index]) return;
  cart.splice(index, 1);
  saveCart(cart);
}

export function clearCart() {
  saveCart([]);
}

export function renderCartPage(showToast) {
  const container = document.getElementById('cart-page-content');
  if (!container) return;

  const cart = getCart();
  container.textContent = '';

  if (cart.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.style.gridColumn = '1 / -1';

    const title = document.createElement('h2');
    title.textContent = 'Your shopping bag is currently empty';

    const desc = document.createElement('p');
    desc.textContent = 'Explore our latest heavyweight athleisure sets and wardrobe essentials.';

    const cta = document.createElement('a');
    cta.href = 'shop.html';
    cta.className = 'btn btn-primary';
    cta.textContent = 'Continue Shopping';

    empty.append(title, desc, cta);
    container.appendChild(empty);
    return;
  }

  const listWrap = document.createElement('div');
  listWrap.className = 'cart-items-list';

  let subtotal = 0;

  cart.forEach((item, index) => {
    const product = getProductById(item.productId);
    const lineTotal = product.price * item.quantity;
    subtotal += lineTotal;

    const card = document.createElement('article');
    card.className = 'cart-item-card';

    const img = document.createElement('img');
    img.className = 'cart-item-img';
    img.src = product.images[0].src;
    img.alt = product.name;

    const details = document.createElement('div');
    details.className = 'cart-item-details';

    const nameLink = document.createElement('a');
    nameLink.href = `product.html?id=${encodeURIComponent(product.id)}`;
    const h2 = document.createElement('h2');
    h2.textContent = product.name;
    nameLink.appendChild(h2);

    const meta = document.createElement('p');
    meta.className = 'cart-item-meta';
    meta.textContent = `Color: ${item.color} | Size: ${item.size}`;

    const stepper = document.createElement('div');
    stepper.className = 'qty-stepper';

    const decBtn = document.createElement('button');
    decBtn.type = 'button';
    decBtn.setAttribute('aria-label', `Decrease quantity of ${product.name}`);
    decBtn.textContent = '−';
    decBtn.addEventListener('click', () => {
      updateCartItemQuantity(index, -1);
      renderCartPage(showToast);
    });

    const qtyVal = document.createElement('span');
    qtyVal.textContent = String(item.quantity);

    const incBtn = document.createElement('button');
    incBtn.type = 'button';
    incBtn.setAttribute('aria-label', `Increase quantity of ${product.name}`);
    incBtn.textContent = '+';
    incBtn.addEventListener('click', () => {
      updateCartItemQuantity(index, 1);
      renderCartPage(showToast);
    });

    stepper.append(decBtn, qtyVal, incBtn);
    details.append(nameLink, meta, stepper);

    const rightCol = document.createElement('div');
    rightCol.style.textAlign = 'right';

    const priceEl = document.createElement('p');
    priceEl.style.fontWeight = '500';
    priceEl.textContent = formatCurrency(lineTotal);

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'link-underline';
    removeBtn.textContent = 'Remove';
    removeBtn.addEventListener('click', () => {
      removeCartItem(index);
      renderCartPage(showToast);
      if (showToast) showToast('Item removed from bag.');
    });

    rightCol.append(priceEl, removeBtn);
    card.append(img, details, rightCol);
    listWrap.appendChild(card);
  });

  const shipping = subtotal >= 250 ? 0 : 15;
  const total = subtotal + shipping;

  const summary = document.createElement('aside');
  summary.className = 'cart-summary-card';
  summary.innerHTML = `
    <h2>Order Summary</h2>
    <div class="summary-row">
      <span>Subtotal</span>
      <span>${formatCurrency(subtotal)}</span>
    </div>
    <div class="summary-row">
      <span>Estimated Shipping</span>
      <span>${shipping === 0 ? 'Complimentary' : formatCurrency(shipping)}</span>
    </div>
    <div class="summary-row total">
      <span>Estimated Total</span>
      <span>${formatCurrency(total)}</span>
    </div>
    <button type="button" class="btn btn-primary btn-full" id="static-checkout-btn">Proceed to Checkout</button>
    <div class="static-notice" id="checkout-notice">
      <strong>Static Storefront Notice:</strong> Live payment processing and order fulfillment require connecting a payment gateway (such as Stripe Checkout or Shopify Buy Button) and backend order service.
    </div>
  `;

  container.append(listWrap, summary);

  const checkoutBtn = document.getElementById('static-checkout-btn');
  if (checkoutBtn && showToast) {
    checkoutBtn.addEventListener('click', () => {
      showToast('Connect Stripe Checkout or a backend API to process live payments.');
    });
  }
}
