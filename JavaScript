export function showToast(message) {
  const container = document.getElementById('toast-container');
  if (!container) return;

  const toast = document.createElement('div');
  toast.className = 'toast';
  toast.textContent = message;
  container.appendChild(toast);

  window.setTimeout(() => {
    toast.remove();
  }, 3400);
}

export function createProductCard(product, onWishlistChange) {
  const article = document.createElement('article');
  article.className = 'product-card';

  const media = document.createElement('div');
  media.className = 'product-card-media';

  const link = document.createElement('a');
  link.href = `product.html?id=${encodeURIComponent(product.id)}`;
  link.setAttribute('aria-label', `View ${product.name}`);

  const primaryImg = product.images[0];
  const img = document.createElement('img');
  img.src = primaryImg.src;
  img.alt = primaryImg.alt;
  img.loading = 'lazy';
  if (primaryImg.fit === 'cover') {
    img.classList.add('cover-fit');
  }
  link.appendChild(img);

  const badges = document.createElement('div');
  badges.className = 'product-badges';
  if (product.isNew) {
    const newBadge = document.createElement('span');
    newBadge.className = 'tag-badge';
    newBadge.textContent = 'New In';
    badges.appendChild(newBadge);
  }
  if (product.isBestSeller) {
    const bestBadge = document.createElement('span');
    bestBadge.className = 'tag-badge sage';
    bestBadge.textContent = 'Best Seller';
    badges.appendChild(bestBadge);
  }

  const wishBtn = document.createElement('button');
  wishBtn.type = 'button';
  wishBtn.className = 'wishlist-card-btn';
  const saved = isInWishlist(product.id);
  if (saved) wishBtn.classList.add('is-saved');
  wishBtn.setAttribute('aria-label', saved ? `Remove ${product.name} from wishlist` : `Save ${product.name} to wishlist`);
  wishBtn.innerHTML = `
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M12 20.5s-7-4.35-9.2-8.5C1.1 8.8 3.2 5 6.8 5c2.1 0 3.8 1.2 5.2 2.9C13.4 6.2 15.1 5 17.2 5c3.6 0 5.7 3.8 4 7-2.2 4.15-9.2 8.5-9.2 8.5z"></path>
    </svg>
  `;

  wishBtn.addEventListener('click', () => {
    const isNowSaved = toggleWishlist(product.id);
    wishBtn.classList.toggle('is-saved', isNowSaved);
    wishBtn.setAttribute('aria-label', isNowSaved ? `Remove ${product.name} from wishlist` : `Save ${product.name} to wishlist`);
    showToast(isNowSaved ? `Saved "${product.name}" to wishlist.` : `Removed "${product.name}" from wishlist.`);
    if (typeof onWishlistChange === 'function') {
      onWishlistChange();
    }
  });

  media.append(link, badges, wishBtn);

  const meta = document.createElement('div');
  meta.className = 'product-card-meta';

  const cat = document.createElement('span');
  cat.className = 'product-card-category';
  cat.textContent = product.category;

  const titleLink = document.createElement('a');
  titleLink.href = `product.html?id=${encodeURIComponent(product.id)}`;
  const title = document.createElement('h3');
  title.className = 'product-card-title';
  title.textContent = product.name;
  titleLink.appendChild(title);

  const price = document.createElement('span');
  price.className = 'product-card-price';
  price.textContent = formatCurrency(product.price);

  const swatches = document.createElement('div');
  swatches.className = 'product-card-swatches';
  product.colors.forEach((color) => {
    const dot = document.createElement('span');
    dot.className = 'swatch-dot';
    dot.style.backgroundColor = color.hex;
    dot.title = color.name;
    swatches.appendChild(dot);
  });

  meta.append(cat, titleLink, price, swatches);
  article.append(media, meta);
  return article;
}

