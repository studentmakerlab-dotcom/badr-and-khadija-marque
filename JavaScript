const WISHLIST_STORAGE_KEY = 'bk_official_wishlist_v1';

export function getWishlist() {
  try {
    const raw = localStorage.getItem(WISHLIST_STORAGE_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch (error) {
    console.error('Unable to read wishlist from localStorage:', error);
    return [];
  }
}

function saveWishlist(ids) {
  try {
    localStorage.setItem(WISHLIST_STORAGE_KEY, JSON.stringify(ids));
  } catch (error) {
    console.error('Unable to save wishlist to localStorage:', error);
  }
  updateWishlistBadge();
}

export function updateWishlistBadge() {
  const badge = document.getElementById('wishlist-count');
  if (!badge) return;
  badge.textContent = String(getWishlist().length);
}

export function isInWishlist(productId) {
  return getWishlist().includes(productId);
}

export function toggleWishlist(productId) {
  const list = getWishlist();
  const idx = list.indexOf(productId);
  let added = false;

  if (idx > -1) {
    list.splice(idx, 1);
  } else {
    list.push(productId);
    added = true;
  }

  saveWishlist(list);
  return added;
}

export function renderWishlistPage(showToast) {
  const container = document.getElementById('wishlist-page-content');
  if (!container) return;

  const savedIds = getWishlist();
  const savedProducts = PRODUCTS.filter((p) => savedIds.includes(p.id));
  container.textContent = '';

  if (savedProducts.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'empty-state';

    const title = document.createElement('h2');
    title.textContent = 'Your wishlist is empty';

    const desc = document.createElement('p');
    desc.textContent = 'Tap the heart icon on any piece in the collection to save it here.';

    const cta = document.createElement('a');
    cta.href = 'shop.html';
    cta.className = 'btn btn-primary';
    cta.textContent = 'Explore Collection';

    empty.append(title, desc, cta);
    container.appendChild(empty);
    return;
  }

  const grid = document.createElement('div');
  grid.className = 'product-grid';

  savedProducts.forEach((product) => {
    grid.appendChild(
      createProductCard(product, () => {
        renderWishlistPage(showToast);
      })
    );
  });

  container.appendChild(grid);
}
export function initNavigation() {
  const openBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('mobile-nav-backdrop');

  if (!openBtn || !drawer || !backdrop) return;

  function openMenu() {
    drawer.hidden = false;
    backdrop.hidden = false;
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    if (closeBtn) closeBtn.focus();
  }

  function closeMenu() {
    drawer.hidden = true;
    backdrop.hidden = true;
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);
  backdrop.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !drawer.hidden) {
      closeMenu();
    }
  });
}
