import { PRODUCTS } from './products.js';
import { createProductCard } from './main.js';

function initShopPage() {
  const grid = document.getElementById('shop-product-grid');
  if (!grid) return;

  const pillsContainer = document.getElementById('category-filter-pills');
  const searchInput = document.getElementById('shop-search-input');
  const priceSelect = document.getElementById('price-filter-select');
  const sortSelect = document.getElementById('sort-select');
  const resultsCount = document.getElementById('results-count');
  const resetBtn = document.getElementById('reset-filters-btn');
  const emptyState = document.getElementById('shop-empty-state');
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const pageTitle = document.getElementById('shop-page-title');

  const params = new URLSearchParams(window.location.search);

  const state = {
    category: params.get('category') || 'All',
    search: '',
    priceRange: 'all',
    sort: params.get('sort') || (params.get('filter') === 'new' ? 'newest' : 'featured'),
    onlyNew: params.get('filter') === 'new'
  };

  if (params.get('focus') === 'search' && searchInput) {
    searchInput.focus();
  }

  if (sortSelect && ['featured', 'newest', 'bestsellers', 'price-asc', 'price-desc'].includes(state.sort)) {
    sortSelect.value = state.sort;
  }

  function syncActivePill() {
    if (!pillsContainer) return;
    pillsContainer.querySelectorAll('.pill-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.category === state.category);
    });
    if (pageTitle) {
      if (state.onlyNew && state.category === 'All') {
        pageTitle.textContent = 'New Arrivals';
      } else if (state.category !== 'All') {
        pageTitle.textContent = state.category;
      } else {
        pageTitle.textContent = 'The Collection';
      }
    }
  }

  function applyFilters() {
    let filtered = [...PRODUCTS];

    if (state.onlyNew) {
      filtered = filtered.filter((p) => p.isNew);
    }

    if (state.category !== 'All') {
      filtered = filtered.filter((p) => p.category.toLowerCase() === state.category.toLowerCase());
    }

    if (state.search) {
      const q = state.search.toLowerCase();
      filtered = filtered.filter(
        (p) =>
          p.name.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.category.toLowerCase().includes(q) ||
          p.colors.some((c) => c.name.toLowerCase().includes(q))
      );
    }

    if (state.priceRange === 'under-100') {
      filtered = filtered.filter((p) => p.price < 100);
    } else if (state.priceRange === '100-175') {
      filtered = filtered.filter((p) => p.price >= 100 && p.price <= 175);
    } else if (state.priceRange === 'over-175') {
      filtered = filtered.filter((p) => p.price > 175);
    }

    if (state.sort === 'price-asc') {
      filtered.sort((a, b) => a.price - b.price);
    } else if (state.sort === 'price-desc') {
      filtered.sort((a, b) => b.price - a.price);
    } else if (state.sort === 'newest') {
      filtered.sort((a, b) => Number(b.isNew) - Number(a.isNew) || a.releaseOrder - b.releaseOrder);
    } else if (state.sort === 'bestsellers') {
      filtered.sort((a, b) => Number(b.isBestSeller) - Number(a.isBestSeller) || a.releaseOrder - b.releaseOrder);
    }

    grid.textContent = '';
    filtered.forEach((product) => grid.appendChild(createProductCard(product)));

    if (resultsCount) {
      resultsCount.textContent = `Showing ${filtered.length} ${filtered.length === 1 ? 'piece' : 'pieces'}`;
    }

    const hasActiveFilters =
      state.category !== 'All' || state.search !== '' || state.priceRange !== 'all' || state.onlyNew;

    if (resetBtn) resetBtn.hidden = !hasActiveFilters;
    if (emptyState) emptyState.hidden = filtered.length > 0;
  }

  function resetAll() {
    state.category = 'All';
    state.search = '';
    state.priceRange = 'all';
    state.sort = 'featured';
    state.onlyNew = false;

    if (searchInput) searchInput.value = '';
    if (priceSelect) priceSelect.value = 'all';
    if (sortSelect) sortSelect.value = 'featured';

    syncActivePill();
    applyFilters();
  }

  if (pillsContainer) {
    pillsContainer.addEventListener('click', (event) => {
      const btn = event.target.closest('.pill-btn');
      if (!btn) return;
      state.category = btn.dataset.category;
      state.onlyNew = false;
      syncActivePill();
      applyFilters();
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (event) => {
      state.search = event.target.value.trim();
      applyFilters();
    });
  }

  if (priceSelect) {
    priceSelect.addEventListener('change', (event) => {
      state.priceRange = event.target.value;
      applyFilters();
    });
  }

  if (sortSelect) {
    sortSelect.addEventListener('change', (event) => {
      state.sort = event.target.value;
      applyFilters();
    });
  }

  if (resetBtn) resetBtn.addEventListener('click', resetAll);
  if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

  syncActivePill();
  applyFilters();
}

document.addEventListener('DOMContentLoaded', initShopPage);
import { PRODUCTS, getProductById, formatCurrency } from './products.js';
import { addToCart } from './cart.js';
import { isInWishlist, toggleWishlist } from './wishlist.js';
import { createProductCard, showToast } from './main.js';

function initProductDetailPage() {
  const container = document.getElementById('product-detail-container');
  if (!container) return;

  const params = new URLSearchParams(window.location.search);
  const product = getProductById(params.get('id'));

  document.title = `${product.name} | BK Official`;

  const catCrumb = document.getElementById('breadcrumb-category');
  const prodCrumb = document.getElementById('breadcrumb-product');
  if (catCrumb) {
    catCrumb.textContent = product.category;
    catCrumb.href = `shop.html?category=${encodeURIComponent(product.category)}`;
  }
  if (prodCrumb) {
    prodCrumb.textContent = product.name;
  }

  let selectedColor = product.colors[0].name;
  let selectedSize = product.sizes.includes('M') ? 'M' : product.sizes[0];
  let quantity = 1;

  container.innerHTML = `
    <div class="pdp-gallery">
      <div class="pdp-main-image">
        <img id="pdp-active-img" src="${product.images[0].src}" alt="${product.images[0].alt}" class="${product.images[0].fit === 'cover' ? 'cover-fit' : ''}">
      </div>
      <div class="pdp-thumbnails" id="pdp-thumbnails"></div>
    </div>

    <div class="pdp-info">
      <span class="eyebrow">${product.category} ${product.inStock ? '• IN STOCK' : '• ARCHIVED'}</span>
      <h1 class="pdp-title">${product.name}</h1>
      <p class="pdp-price">${formatCurrency(product.price)}</p>
      <p class="pdp-description">${product.description}</p>

      <div class="option-group">
        <span class="option-label">Color: <strong id="selected-color-label">${selectedColor}</strong></span>
        <div class="color-options" id="pdp-color-options"></div>
      </div>

      <div class="option-group">
        <span class="option-label">Size: <strong id="selected-size-label">${selectedSize}</strong></span>
        <div class="size-options" id="pdp-size-options"></div>
      </div>

      <div class="option-group">
        <span class="option-label">Quantity</span>
        <div class="qty-stepper">
          <button type="button" id="pdp-qty-dec" aria-label="Decrease quantity">−</button>
          <span id="pdp-qty-val">1</span>
          <button type="button" id="pdp-qty-inc" aria-label="Increase quantity">+</button>
        </div>
      </div>

      <div class="pdp-actions">
        <button type="button" class="btn btn-primary" id="pdp-add-to-cart">Add to Shopping Bag</button>
        <button type="button" class="btn btn-outline" id="pdp-wishlist-btn">
          ${isInWishlist(product.id) ? 'Saved in Wishlist' : 'Save to Wishlist'}
        </button>
      </div>

      <div class="pdp-accordions">
        <details open>
          <summary>Fabrication &amp; Construction</summary>
          <p>${product.details}</p>
        </details>
        <details>
          <summary>Shipping &amp; Returns</summary>
          <p>${product.shipping}</p>
        </details>
      </div>
    </div>
  `;

  // Thumbnails
  const thumbsWrap = document.getElementById('pdp-thumbnails');
  const activeImg = document.getElementById('pdp-active-img');
  product.images.forEach((imgObj, idx) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `pdp-thumb-btn${idx === 0 ? ' active' : ''}`;
    btn.setAttribute('aria-label', `View angle ${idx + 1}`);
    btn.innerHTML = `<img src="${imgObj.src}" alt="${imgObj.alt}">`;
    btn.addEventListener('click', () => {
      activeImg.src = imgObj.src;
      activeImg.alt = imgObj.alt;
      activeImg.classList.toggle('cover-fit', imgObj.fit === 'cover');
      thumbsWrap.querySelectorAll('.pdp-thumb-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
    thumbsWrap.appendChild(btn);
  });

  // Color options
  const colorWrap = document.getElementById('pdp-color-options');
  const colorLabel = document.getElementById('selected-color-label');
  product.colors.forEach((color) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `color-choice-btn${color.name === selectedColor ? ' active' : ''}`;
    btn.innerHTML = `<span class="swatch-dot" style="background-color:${color.hex}"></span><span>${color.name}</span>`;
    btn.addEventListener('click', () => {
      selectedColor = color.name;
      colorLabel.textContent = selectedColor;
      colorWrap.querySelectorAll('.color-choice-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
    colorWrap.appendChild(btn);
  });

  // Size options
  const sizeWrap = document.getElementById('pdp-size-options');
  const sizeLabel = document.getElementById('selected-size-label');
  product.sizes.forEach((size) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `size-choice-btn${size === selectedSize ? ' active' : ''}`;
    btn.textContent = size;
    btn.addEventListener('click', () => {
      selectedSize = size;
      sizeLabel.textContent = selectedSize;
      sizeWrap.querySelectorAll('.size-choice-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
    });
    sizeWrap.appendChild(btn);
  });

  // Quantity controls
  const qtyVal = document.getElementById('pdp-qty-val');
  document.getElementById('pdp-qty-dec').addEventListener('click', () => {
    quantity = Math.max(1, quantity - 1);
    qtyVal.textContent = String(quantity);
  });
  document.getElementById('pdp-qty-inc').addEventListener('click', () => {
    quantity = Math.min(20, quantity + 1);
    qtyVal.textContent = String(quantity);
  });

  // Add to cart
  document.getElementById('pdp-add-to-cart').addEventListener('click', () => {
    addToCart(product.id, selectedSize, selectedColor, quantity);
    showToast(`Added ${quantity} × ${product.name} (${selectedSize}) to bag.`);
  });

  // Wishlist toggle
  const wishBtn = document.getElementById('pdp-wishlist-btn');
  wishBtn.addEventListener('click', () => {
    const isSaved = toggleWishlist(product.id);
    wishBtn.textContent = isSaved ? 'Saved in Wishlist' : 'Save to Wishlist';
    showToast(isSaved ? `Saved "${product.name}" to wishlist.` : `Removed "${product.name}" from wishlist.`);
  });

  // Related Products
  const relatedGrid = document.getElementById('related-products-grid');
  if (relatedGrid) {
    PRODUCTS.filter((p) => p.id !== product.id)
      .slice(0, 4)
      .forEach((rel) => relatedGrid.appendChild(createProductCard(rel)));
  }
}

document.addEventListener('DOMContentLoaded', initProductDetailPage);
